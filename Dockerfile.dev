ARG HUGO_VERSION=0.169.0
FROM ghcr.io/gohugoio/hugo:v${HUGO_VERSION}
ARG PAGEFIND_VERSION=1.6.0
RUN wget -qO- https://github.com/Pagefind/pagefind/releases/download/v${PAGEFIND_VERSION}/pagefind_extended-v${PAGEFIND_VERSION}-x86_64-unknown-linux-musl.tar.gz | tar -xz -C /var/hugo/bin pagefind_extended
# Re-index after each completed build: Hugo prints "Press Ctrl+C" after the first and "Total in" after each rebuild.
ENTRYPOINT [ "sh", "-c", "hugo server -D --bind 0.0.0.0 --disableFastRender --destination /tmp/public | while IFS= read -r line; do echo \"$line\"; case $line in *'Press Ctrl+C'*|*'Total in'*) pagefind_extended --site /tmp/public;; esac; done" ]
