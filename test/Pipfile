[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# pinning playwright version
pytest-playwright = "==0.10.0"
playwright = "==1.64.1"
pytest-metadata = "==3.1.1"
# allows parallelism to happen: https://playwright.dev/python/docs/test-runners#parallelism-running-multiple-tests-at-once
pytest-xdist = "==3.8.0"

[dev-packages]
# code formatter
black = "==26.10.1"
# code linter
pylint = "==4.1.3"

[requires]
python_version = "3.12"
